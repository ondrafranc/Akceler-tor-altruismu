{
  "name": "Akcelerátor altruismu (SvelteKit)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "vscode": {
      "settings": {
        "typescript.tsdk": "akcelerator-landing-page/node_modules/typescript/lib"
      },
      "extensions": [
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright"
      ]
    }
  },
  "postCreateCommand": "cd akcelerator-landing-page && npm install && npx playwright install-deps chromium",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "SvelteKit Dev Server",
      "onAutoForward": "openPreview"
    }
  }
}
